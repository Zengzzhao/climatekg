GOOGLE_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
NEO4J_URI=neo4j://localhost:8687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Markdown extraction (extract_md_deepseek.py)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# CUC校园服务：替换上面三项；校外需要连接学校VPN。
# DEEPSEEK_API_KEY=<个人CUC API密钥>
# DEEPSEEK_BASE_URL=https://openai.cuc.edu.cn/v1
# DEEPSEEK_MODEL=cuc/deepseek
# 检查连接：.venv/bin/python extraction/check_api.py

# Optional remote OpenAI-compatible vLLM service.
# Select per run with --backend vllm, or set EXTRACTION_BACKEND=vllm.
VLLM_BASE_URL=https://lryd5kgi-bwbkdaqq-8000.ahrestapi.gpufree.cn:8443/v1
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
VLLM_API_KEY=

# Optional zrshuiwu service, available to both new and legacy workflows.
# Select with --backend zrshuiwu, or set EXTRACTION_BACKEND=zrshuiwu.
# Existing DEEPSEEK_* / VLLM_* settings can be kept alongside these.
ZRSHUIWU_BASE_URL=https://llm.zrshuiwu.com/v1
ZRSHUIWU_MODEL=deepseek-v4.1-flash-1017
ZRSHUIWU_API_KEY=

# Fixed local BGE checkpoint for the default compact-350 evidence pool.
# Default directory: extraction/embedding_files/bge-small-en-v1.5/
# BGE_MODEL_DIR=/absolute/path/to/bge-small-en-v1.5
